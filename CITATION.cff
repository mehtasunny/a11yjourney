    family-names: Mehta
    email: sunnykmehta@gmail.com
repository-code: "https://github.com/mehtasunny/a11yjourney"
license: MIT
version: 0.2.1
keywords:
  - accessibility
  - android
  - wcag
  - mobile testing
  - screen reader
  - low vision

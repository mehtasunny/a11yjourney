+package org.onebusaway.android.ui.arrivals
+
+import android.content.Context
+import androidx.compose.ui.test.hasStateDescription
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Rule
+import org.junit.Test
+import org.onebusaway.android.R
+import org.onebusaway.android.models.Status
+import org.onebusaway.android.ui.arrivals.components.RouteArrivalRow
+import org.onebusaway.android.ui.arrivals.components.previewArrival
+import org.onebusaway.android.ui.arrivals.components.previewRowCallbacks
+import org.onebusaway.android.ui.compose.createUnconfinedComposeRule
+
+/**
+ * A strip pill's status reaches accessibility services as words, not only as the pill's fill colour,
+ * live glyph and strikethrough. Asserted through the pill's state description, so the test states the
+ * meaning a screen reader announces rather than sampling the colour.
+ */
+class EtaPillStatusDescriptionTest {
+
+    // See createUnconfinedComposeRule for why Unconfined composition is used here (issue #1792).
+    @get:Rule
+    val composeRule = createUnconfinedComposeRule()
+
+    private val context: Context
+        get() = InstrumentationRegistry.getInstrumentation().targetContext
+
+    @Test
+    fun aCanceledTripsPillSaysItIsCanceled() {
+        setRow(previewArrival("40", "Northgate", etaMinutes = 8, status = Status.CANCELED, context = context))
+
+        composeRule.onNode(hasStateDescription(context.getString(R.string.stop_info_canceled))).assertExists()
+    }
+
+    @Test
+    fun aScheduleOnlyTripsPillSaysItIsScheduled() {
+        setRow(previewArrival("40", "Northgate", etaMinutes = 8, predicted = false, context = context))
+
+        composeRule.onNode(hasStateDescription(context.getString(R.string.stop_info_scheduled))).assertExists()
+    }
+
+    @Test
+    fun anOnTimeLiveTripsPillSaysItIsOnTime() {
+        setRow(previewArrival("40", "Northgate", etaMinutes = 8, context = context))
+
+        composeRule.onNode(hasStateDescription(context.getString(R.string.stop_info_ontime))).assertExists()
+    }
+
+    private fun setRow(arrival: ArrivalInfo) {
+        composeRule.setContent {
+            RouteArrivalRow(
+                group = RouteRowGroup(listOf(arrival)),
+                actionsFor = { null },
+                isFavorite = false,
+                callbacks = previewRowCallbacks()
+            )
+        }
+    }
+}
